#!/usr/bin/env python3
"""Calculate Cursor usage and billing-cycle weekly progress.

Supports two response formats:
1) Itemized records with date + amount fields (legacy mode).
2) Cursor usage-summary payload (auto-detected by billingCycleStart/billingCycleEnd).

Additionally fetches recent usage events from the filtered-usage-events API
to display the last N calls and compute actual (non-estimated) weekly totals.

Usage examples:
  cursor-usage --json-file usage-summary.json
  cursor-usage --url "https://cursor.com/api/usage-summary" \
    --header "Cookie: __Secure-next-auth.session-token=<token>"
  cursor-usage --events-url "https://cursor.com/api/dashboard/get-filtered-usage-events" \
    --team-id 18803605
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen

STATE_DIR = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")) / "cursor-usage"
STATE_FILE = STATE_DIR / "weekly-snapshots.json"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Get Cursor usage and weekly billing-cycle progress."
    )
    parser.add_argument(
        "--month",
        help="Target month in YYYY-MM format (default: current month).",
    )
    parser.add_argument(
        "--json-file",
        help="Path to a local JSON file with usage data.",
    )
    parser.add_argument(
        "--url",
        default="https://cursor.com/api/usage-summary",
        help="Usage API endpoint URL (default: https://cursor.com/api/usage-summary).",
    )
    parser.add_argument(
        "--events-url",
        default="https://cursor.com/api/dashboard/get-filtered-usage-events",
        help="Filtered usage events API endpoint.",
    )
    parser.add_argument(
        "--events-json-file",
        help="Path to a local JSON file with filtered usage events data.",
    )
    parser.add_argument(
        "--team-id",
        help="Team ID for the filtered usage events API.",
    )
    parser.add_argument(
        "--team-id-env",
        default="CURSOR_TEAM_ID",
        help="Env var name containing the Cursor team ID (default: CURSOR_TEAM_ID).",
    )
    parser.add_argument(
        "--last-n-events",
        type=int,
        default=5,
        help="Number of recent events to display (default: 5).",
    )
    parser.add_argument(
        "--method",
        default="GET",
        help="HTTP method to use with --url (default: GET).",
    )
    parser.add_argument(
        "--header",
        action="append",
        default=[],
        help='HTTP header, repeatable. Example: --header "Authorization: Bearer <token>"',
    )
    parser.add_argument(
        "--body",
        help='Optional JSON request body string for non-GET requests. Example: \'{"foo":"bar"}\'',
    )
    parser.add_argument(
        "--items-path",
        default="items",
        help=(
            "Dot path to the list of usage items in the response JSON "
            "(default: items). Use empty string to enable auto-detection."
        ),
    )
    parser.add_argument(
        "--date-fields",
        default="createdAt,timestamp,date,time",
        help="Comma-separated candidate date field names.",
    )
    parser.add_argument(
        "--amount-fields",
        default="costUsd,cost_usd,amountUsd,amount_usd,cost,price",
        help="Comma-separated candidate USD field names.",
    )
    parser.add_argument(
        "--summary-metric",
        default="individualUsage.overall",
        help=(
            "Metric path for usage-summary payload "
            '(default: individualUsage.overall; alternatives: teamUsage.pooled, teamUsage.onDemand).'
        ),
    )
    parser.add_argument(
        "--usd-per-unit",
        type=float,
        help=(
            "Optional conversion rate from usage units to USD "
            "(for usage-summary mode)."
        ),
    )
    parser.add_argument(
        "--bar-width",
        type=int,
        default=24,
        help="Width of progress bars (default: 24).",
    )
    parser.add_argument(
        "--now",
        help="Override current time in ISO-8601 (useful for testing).",
    )
    parser.add_argument(
        "--session-token-env",
        default="CURSOR_SESSION_TOKEN",
        help=(
            "Env var name containing the Cursor session token "
            "(default: CURSOR_SESSION_TOKEN)."
        ),
    )
    parser.add_argument(
        "--cookie-name",
        default="WorkosCursorSessionToken",
        help="Cookie name used for Cursor auth (default: WorkosCursorSessionToken).",
    )
    parser.add_argument(
        "--save-snapshot",
        action="store_true",
        help="Save the current week's actual usage as a snapshot (run at end of week).",
    )
    return parser.parse_args()


def parse_month(value: str | None) -> tuple[int, int]:
    if not value:
        now = datetime.now(tz=timezone.utc)
        return now.year, now.month
    try:
        dt = datetime.strptime(value, "%Y-%m")
    except ValueError as exc:
        raise ValueError("--month must be in YYYY-MM format.") from exc
    return dt.year, dt.month


def parse_headers(values: list[str]) -> dict[str, str]:
    headers: dict[str, str] = {}
    for raw in values:
        if ":" not in raw:
            raise ValueError(f'Invalid --header "{raw}". Expected "Key: Value".')
        key, value = raw.split(":", 1)
        headers[key.strip()] = value.strip()
    return headers


def apply_session_cookie_from_env(
    headers: dict[str, str],
    env_name: str,
    cookie_name: str,
) -> dict[str, str]:
    if any(k.lower() == "cookie" for k in headers):
        return headers

    token = os.environ.get(env_name, "").strip()
    if not token:
        return headers

    next_headers = dict(headers)
    next_headers["Cookie"] = f"{cookie_name}={token}"
    return next_headers


def load_json_from_url(
    url: str,
    method: str,
    headers: dict[str, str],
    body: str | None,
) -> Any:
    data = None
    if body:
        data = body.encode("utf-8")
        headers.setdefault("Content-Type", "application/json")
    request = Request(url=url, method=method.upper(), headers=headers, data=data)
    try:
        with urlopen(request) as response:
            payload = response.read().decode("utf-8")
            return json.loads(payload)
    except HTTPError as exc:
        raise RuntimeError(f"HTTP error {exc.code}: {exc.reason}") from exc
    except URLError as exc:
        raise RuntimeError(f"Network error: {exc.reason}") from exc
    except json.JSONDecodeError as exc:
        raise RuntimeError("Response is not valid JSON.") from exc


def load_json_from_file(path: str) -> Any:
    try:
        with open(path, "r", encoding="utf-8") as file:
            return json.load(file)
    except FileNotFoundError as exc:
        raise RuntimeError(f"File not found: {path}") from exc
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"Invalid JSON in file: {path}") from exc


def resolve_path(root: Any, path: str) -> Any:
    if not path:
        return root
    current = root
    for part in path.split("."):
        if isinstance(current, list) and part.isdigit():
            index = int(part)
            current = current[index]
        elif isinstance(current, dict):
            current = current.get(part)
        else:
            return None
    return current


def detect_items(data: Any) -> list[dict[str, Any]]:
    if isinstance(data, list):
        return [x for x in data if isinstance(x, dict)]
    if not isinstance(data, dict):
        return []
    for key in ("items", "data", "results", "usage", "requests"):
        value = data.get(key)
        if isinstance(value, list):
            return [x for x in value if isinstance(x, dict)]
    return []


def extract_items(data: Any, items_path: str) -> list[dict[str, Any]]:
    resolved = resolve_path(data, items_path) if items_path else None
    if isinstance(resolved, list):
        return [x for x in resolved if isinstance(x, dict)]
    return detect_items(data)


def parse_datetime(value: Any) -> datetime | None:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        ts = float(value)
        if ts > 1e12:
            ts /= 1000.0
        return datetime.fromtimestamp(ts, tz=timezone.utc)
    if isinstance(value, str):
        text = value.strip()
        if not text:
            return None
        if text.isdigit():
            ts = float(text)
            if ts > 1e12:
                ts /= 1000.0
            return datetime.fromtimestamp(ts, tz=timezone.utc)
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"
        try:
            dt = datetime.fromisoformat(text)
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            return dt
        except ValueError:
            return None
    return None


def parse_amount(value: Any) -> float | None:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return float(value)
    if isinstance(value, str):
        text = value.strip().replace("$", "").replace(",", "")
        if not text:
            return None
        try:
            return float(text)
        except ValueError:
            return None
    return None


def format_bar(ratio: float, width: int) -> str:
    safe_ratio = max(0.0, min(1.0, ratio))
    filled = int(round(safe_ratio * width))
    return f"[{'#' * filled}{'.' * (width - filled)}]"


def parse_now(now_value: str | None) -> datetime:
    if not now_value:
        return datetime.now(tz=timezone.utc)
    parsed = parse_datetime(now_value)
    if parsed is None:
        raise ValueError("--now must be a valid ISO-8601 date-time.")
    return parsed.astimezone(timezone.utc)


def is_usage_summary_payload(data: Any) -> bool:
    return (
        isinstance(data, dict)
        and "billingCycleStart" in data
        and "billingCycleEnd" in data
    )


def is_filtered_events_payload(data: Any) -> bool:
    return (
        isinstance(data, dict)
        and "usageEventsDisplay" in data
        and "totalUsageEventsCount" in data
    )


def get_metric(summary: dict[str, Any], path: str) -> dict[str, Any]:
    value = resolve_path(summary, path)
    if not isinstance(value, dict):
        raise RuntimeError(f'Metric path "{path}" was not found in usage-summary payload.')
    return value


def clamp_dt(value: datetime, start: datetime, end: datetime) -> datetime:
    if value < start:
        return start
    if value > end:
        return end
    return value


# --- Weekly snapshot persistence ---

def load_snapshots() -> dict[str, Any]:
    if not STATE_FILE.exists():
        return {}
    try:
        return json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return {}


def save_snapshots(snapshots: dict[str, Any]) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(json.dumps(snapshots, indent=2), encoding="utf-8")


def get_week_key(cycle_start: datetime, week_start: datetime) -> str:
    return f"{cycle_start.date()}|{week_start.date()}"


def compute_week_boundaries(
    cycle_start: datetime, cycle_end: datetime, now: datetime
) -> list[tuple[datetime, datetime, int]]:
    """Return list of (week_start, week_end, week_index) for the billing cycle."""
    weeks = []
    ws = cycle_start
    idx = 1
    while ws < cycle_end:
        we = min(ws + timedelta(days=7), cycle_end)
        weeks.append((ws, we, idx))
        ws = we
        idx += 1
    return weeks


def find_current_week(
    weeks: list[tuple[datetime, datetime, int]], now: datetime, cycle_end: datetime
) -> tuple[datetime, datetime, int]:
    for ws, we, idx in weeks:
        if ws <= now < we or (now == cycle_end and we == cycle_end):
            return ws, we, idx
    return weeks[-1]


# --- Filtered usage events ---

def resolve_team_id(args: argparse.Namespace) -> str | None:
    if args.team_id:
        return args.team_id
    return os.environ.get(args.team_id_env, "").strip() or None


def fetch_filtered_events(
    url: str,
    headers: dict[str, str],
    team_id: str,
    start_ms: str,
    end_ms: str,
    page: int = 1,
    page_size: int = 100,
) -> dict[str, Any]:
    body = json.dumps({
        "teamId": int(team_id),
        "startDate": start_ms,
        "endDate": end_ms,
        "page": page,
        "pageSize": page_size,
    })
    req_headers = dict(headers)
    req_headers["Content-Type"] = "application/json"
    return load_json_from_url(url, "POST", req_headers, body)


def format_tokens(n: int) -> str:
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}k"
    return str(n)


def print_recent_events(events: list[dict[str, Any]], count: int) -> None:
    if not events:
        return
    display = events[:count]
    print(f"\nLast {len(display)} usage events:")
    print(f"{'Time (UTC)':<20} {'Model':<20} {'Input':>8} {'Output':>8} {'Cache':>8} {'Cost':>10}")
    print("-" * 78)
    for evt in display:
        ts = parse_datetime(evt.get("timestamp"))
        time_str = ts.strftime("%Y-%m-%d %H:%M") if ts else "?"
        model = evt.get("model", "?")
        token_usage = evt.get("tokenUsage", {})
        input_tok = token_usage.get("inputTokens", 0)
        output_tok = token_usage.get("outputTokens", 0)
        cache_tok = token_usage.get("cacheReadTokens", 0)
        charged = evt.get("chargedCents")
        cost_str = f"${charged / 100:.2f}" if charged is not None else "-"
        print(
            f"{time_str:<20} {model:<20} "
            f"{format_tokens(input_tok):>8} {format_tokens(output_tok):>8} "
            f"{format_tokens(cache_tok):>8} {cost_str:>10}"
        )


def sum_events_in_range(
    events: list[dict[str, Any]], start: datetime, end: datetime
) -> tuple[float, int]:
    """Sum chargedCents for events within [start, end). Returns (total_cents, count)."""
    total = 0.0
    count = 0
    for evt in events:
        ts = parse_datetime(evt.get("timestamp"))
        if ts is None:
            continue
        if start <= ts < end:
            charged = evt.get("chargedCents")
            if charged is not None:
                total += float(charged)
                count += 1
    return total, count


def sum_events_usage_units(
    events: list[dict[str, Any]], start: datetime, end: datetime
) -> tuple[float, int]:
    """Sum requestsCosts (usage units) for events within [start, end). Returns (total_units, count)."""
    total = 0.0
    count = 0
    for evt in events:
        ts = parse_datetime(evt.get("timestamp"))
        if ts is None:
            continue
        if start <= ts < end:
            cost = evt.get("requestsCosts")
            if cost is not None:
                total += float(cost)
                count += 1
    return total, count


def fetch_all_events_in_range(
    url: str,
    headers: dict[str, str],
    team_id: str,
    start: datetime,
    end: datetime,
) -> list[dict[str, Any]]:
    """Fetch all pages of events for a time range."""
    start_ms = str(int(start.timestamp() * 1000))
    end_ms = str(int(end.timestamp() * 1000))
    all_events: list[dict[str, Any]] = []
    page = 1
    while True:
        data = fetch_filtered_events(url, headers, team_id, start_ms, end_ms, page=page, page_size=100)
        events = data.get("usageEventsDisplay", [])
        all_events.extend(events)
        total_count = data.get("totalUsageEventsCount", 0)
        if len(all_events) >= total_count or not events:
            break
        page += 1
    return all_events


# --- Main report ---

def print_summary_weekly_report(
    args: argparse.Namespace,
    data: dict[str, Any],
    events_data: dict[str, Any] | None = None,
    all_week_events: list[dict[str, Any]] | None = None,
) -> None:
    cycle_start = parse_datetime(data.get("billingCycleStart"))
    cycle_end = parse_datetime(data.get("billingCycleEnd"))
    if cycle_start is None or cycle_end is None:
        raise RuntimeError("Invalid billing cycle dates in payload.")
    cycle_start = cycle_start.astimezone(timezone.utc)
    cycle_end = cycle_end.astimezone(timezone.utc)
    if cycle_end <= cycle_start:
        raise RuntimeError("billingCycleEnd must be after billingCycleStart.")

    metric = get_metric(data, args.summary_metric)
    used_raw = parse_amount(metric.get("used"))
    limit_raw = parse_amount(metric.get("limit"))
    enabled = bool(metric.get("enabled", True))
    if used_raw is None:
        raise RuntimeError(f'Metric "{args.summary_metric}" does not include a numeric "used".')

    now = clamp_dt(parse_now(args.now), cycle_start, cycle_end)
    elapsed_seconds = max((now - cycle_start).total_seconds(), 1.0)
    rate_per_second = used_raw / elapsed_seconds
    cycle_total_seconds = (cycle_end - cycle_start).total_seconds()

    print("Cursor usage summary")
    print(f"Billing cycle (UTC): {cycle_start.date()} -> {cycle_end.date()}")
    print(f"Metric: {args.summary_metric} (enabled={enabled})")
    if limit_raw is None:
        print(f"Used: {used_raw:,.0f} units (no limit in payload)")
    else:
        pct = (used_raw / limit_raw * 100.0) if limit_raw > 0 else 0.0
        print(f"Used: {used_raw:,.0f} / {limit_raw:,.0f} units ({pct:.2f}%)")
        print(f"Now:  {format_bar(used_raw / limit_raw if limit_raw > 0 else 0.0, args.bar_width)}")

    if args.usd_per_unit is not None:
        used_usd = used_raw * args.usd_per_unit
        print(f"Used (USD): ${used_usd:,.2f}")
        if limit_raw is not None:
            limit_usd = limit_raw * args.usd_per_unit
            print(f"Limit (USD): ${limit_usd:,.2f}")

    weeks = compute_week_boundaries(cycle_start, cycle_end, now)
    current_week_start, current_week_end, current_week_index = find_current_week(weeks, now, cycle_end)

    snapshots = load_snapshots()
    cycle_key = str(cycle_start.date())

    # Determine actual current-week usage from events if available
    actual_current_week_units: float | None = None
    actual_current_week_events: int = 0

    if all_week_events is not None:
        actual_current_week_units, actual_current_week_events = sum_events_usage_units(
            all_week_events, current_week_start, current_week_end
        )

    # Compute previous weeks' total: use snapshots where available,
    # fall back to pace-based estimate for unsaved weeks.
    previous_weeks_total = 0.0
    has_any_snapshot = False
    all_previous_snapshotted = True
    for ws, we, idx in weeks:
        if idx >= current_week_index:
            break
        wk = get_week_key(cycle_start, ws)
        snap = snapshots.get(cycle_key, {}).get(wk)
        if snap is not None:
            previous_weeks_total += snap.get("used_units", 0.0)
            has_any_snapshot = True
        else:
            week_seconds = (we - ws).total_seconds()
            previous_weeks_total += rate_per_second * week_seconds
            all_previous_snapshotted = False

    if actual_current_week_units is not None:
        current_week_used = actual_current_week_units
        source_label = "actual"
    else:
        current_week_used = max(used_raw - previous_weeks_total, 0.0)
        if has_any_snapshot and all_previous_snapshotted:
            source_label = "actual (from snapshots)"
        elif has_any_snapshot:
            source_label = "partial snapshots + estimated"
        else:
            source_label = "estimated"

    elapsed_in_current_week = max((now - current_week_start).total_seconds(), 0.0)

    print("")
    print(
        f"Current week usage ({source_label}): "
        f"W{current_week_index} {current_week_start.date()}.."
        f"{(current_week_end - timedelta(seconds=1)).date()}"
    )
    if limit_raw is not None and limit_raw > 0:
        current_week_budget = limit_raw * (
            (current_week_end - current_week_start).total_seconds() / cycle_total_seconds
        )
        week_ratio = (
            current_week_used / current_week_budget
            if current_week_budget > 0
            else 0.0
        )
        print(
            f"Used this week: {format_bar(week_ratio, args.bar_width)} "
            f"{week_ratio * 100.0:6.2f}% "
            f"({current_week_used:,.0f} / {current_week_budget:,.0f} units)"
        )
        if actual_current_week_events > 0:
            print(f"Events this week: {actual_current_week_events}")
    else:
        print(f"Used this week: {current_week_used:,.0f} units")
    if args.usd_per_unit is not None:
        print(f"Used this week (USD): ${current_week_used * args.usd_per_unit:,.2f}")
    print(
        f"Week elapsed: {elapsed_in_current_week / (current_week_end - current_week_start).total_seconds() * 100.0:5.1f}%"
    )

    # Save snapshot if requested
    if args.save_snapshot:
        if cycle_key not in snapshots:
            snapshots[cycle_key] = {}
        wk = get_week_key(cycle_start, current_week_start)
        snapshots[cycle_key][wk] = {
            "used_units": current_week_used,
            "week_index": current_week_index,
            "saved_at": now.isoformat(),
            "source": source_label,
        }
        save_snapshots(snapshots)
        print(f"\nSnapshot saved for W{current_week_index} ({wk}): {current_week_used:,.0f} units")

    # Recent events
    if events_data and is_filtered_events_payload(events_data):
        recent = events_data.get("usageEventsDisplay", [])
        print_recent_events(recent, args.last_n_events)

    print("")
    print("Weekly progress (estimated from current cycle pace):")

    week_start = cycle_start
    week_index = 1
    while week_start < cycle_end:
        week_end = min(week_start + timedelta(days=7), cycle_end)
        wk = get_week_key(cycle_start, week_start)
        snap = snapshots.get(cycle_key, {}).get(wk)

        week_label = (
            f"W{week_index} {week_start.date()}..{(week_end - timedelta(seconds=1)).date()}"
        )

        if week_index == current_week_index:
            projected_used = current_week_used
            marker = " <-- current"
        elif snap is not None:
            projected_used = snap.get("used_units", 0.0)
            marker = " (saved)"
        else:
            seconds_from_start = (week_end - cycle_start).total_seconds()
            projected_used_cumulative = rate_per_second * seconds_from_start
            prev_seconds = (week_start - cycle_start).total_seconds()
            projected_used_prev = rate_per_second * prev_seconds
            projected_used = projected_used_cumulative - projected_used_prev
            marker = ""

        if limit_raw is not None and limit_raw > 0:
            week_budget = limit_raw * (
                (week_end - week_start).total_seconds() / cycle_total_seconds
            )
            ratio = projected_used / week_budget if week_budget > 0 else 0.0
            bar = format_bar(ratio, args.bar_width)
            pct = ratio * 100.0
            print(f"{week_label} {bar} {pct:6.2f}% ({projected_used:,.0f} / {week_budget:,.0f} units){marker}")
        else:
            print(f"{week_label} {projected_used:,.0f} units{marker}")

        week_start = week_end
        week_index += 1


def main() -> int:
    args = parse_args()
    try:
        if args.json_file:
            data = load_json_from_file(args.json_file)
        elif args.url:
            headers = parse_headers(args.header)
            headers = apply_session_cookie_from_env(
                headers=headers,
                env_name=args.session_token_env,
                cookie_name=args.cookie_name,
            )
            data = load_json_from_url(args.url, args.method, headers, args.body)
        else:
            raise ValueError("Provide a source: --json-file or --url.")

        # Try to fetch filtered events for recent calls + actual weekly usage
        events_data: dict[str, Any] | None = None
        all_week_events: list[dict[str, Any]] | None = None

        if args.events_json_file:
            events_data = load_json_from_file(args.events_json_file)
        elif is_usage_summary_payload(data):
            team_id = resolve_team_id(args)
            if not team_id:
                print(
                    "Hint: set CURSOR_TEAM_ID or use --team-id to show recent events "
                    "and actual weekly usage.",
                    file=sys.stderr,
                )
            else:
                headers = parse_headers(args.header)
                headers = apply_session_cookie_from_env(
                    headers=headers,
                    env_name=args.session_token_env,
                    cookie_name=args.cookie_name,
                )
                cycle_start = parse_datetime(data.get("billingCycleStart"))
                cycle_end = parse_datetime(data.get("billingCycleEnd"))
                if cycle_start and cycle_end:
                    cycle_start = cycle_start.astimezone(timezone.utc)
                    cycle_end = cycle_end.astimezone(timezone.utc)
                    now_dt = clamp_dt(parse_now(args.now), cycle_start, cycle_end)

                    # Fetch recent events (page 1 only, for display)
                    start_ms = str(int(cycle_start.timestamp() * 1000))
                    end_ms = str(int(now_dt.timestamp() * 1000))
                    try:
                        events_data = fetch_filtered_events(
                            args.events_url, headers, team_id,
                            start_ms, end_ms, page=1, page_size=args.last_n_events,
                        )
                    except RuntimeError:
                        pass

                    # Fetch all events for current week to compute actual usage
                    weeks = compute_week_boundaries(cycle_start, cycle_end, now_dt)
                    cw_start, cw_end, _ = find_current_week(weeks, now_dt, cycle_end)
                    try:
                        all_week_events = fetch_all_events_in_range(
                            args.events_url, headers, team_id, cw_start, now_dt,
                        )
                    except RuntimeError:
                        pass

        if is_usage_summary_payload(data):
            print_summary_weekly_report(args, data, events_data, all_week_events)
            return 0

        if is_filtered_events_payload(data):
            events = data.get("usageEventsDisplay", [])
            total = data.get("totalUsageEventsCount", 0)
            print(f"Cursor filtered usage events ({total} total)")
            print_recent_events(events, args.last_n_events)
            return 0

        target_year, target_month = parse_month(args.month)
        items = extract_items(data, args.items_path)
        if not items:
            raise RuntimeError(
                "No usage items found. For usage-summary payload, use billingCycleStart/billingCycleEnd response."
            )

        date_fields = [field.strip() for field in args.date_fields.split(",") if field.strip()]
        amount_fields = [field.strip() for field in args.amount_fields.split(",") if field.strip()]

        total_usd = 0.0
        matched_count = 0

        for item in items:
            date_value = next((item.get(field) for field in date_fields if field in item), None)
            amount_value = next(
                (item.get(field) for field in amount_fields if field in item),
                None,
            )

            dt = parse_datetime(date_value)
            amount = parse_amount(amount_value)
            if dt is None or amount is None:
                continue
            if dt.year == target_year and dt.month == target_month:
                total_usd += amount
                matched_count += 1

        month_label = f"{target_year:04d}-{target_month:02d}"
        print(f"Cursor usage month: {month_label}")
        print(f"Matched records: {matched_count}")
        print(f"Total usage (USD): ${total_usd:.2f}")
        return 0
    except (ValueError, RuntimeError) as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
