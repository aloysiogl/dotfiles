#!/bin/sh
#
# Open a pull request or remote branch in a temporary worktree.
#
# USAGE:
#
#   review https://github.com/owner/repository/pull/123
#   review feature/my-branch

set -eu

fail() {
  printf 'review: %s\n' "$*" >&2
  exit 1
}

absolute_common_dir() {
  worktree=$1
  common_dir=$(git -C "$worktree" rev-parse --git-common-dir 2>/dev/null) ||
    return 1

  case "$common_dir" in
    /*) ;;
    *) common_dir=$worktree/$common_dir ;;
  esac

  (cd "$common_dir" 2>/dev/null && pwd -P)
}

branch_worktree() {
  git worktree list --porcelain | awk -v branch="refs/heads/$1" '
    $1 == "worktree" {
      path = substr($0, 10)
    }
    $1 == "branch" && $2 == branch {
      print path
      exit
    }
  '
}

[ "$#" -eq 1 ] || fail "usage: review <pull-request-url|branch>"
command -v git >/dev/null 2>&1 || fail "git is required"
command -v e >/dev/null 2>&1 || fail "e is required"

target=$1
repo_root=$(git rev-parse --show-toplevel 2>/dev/null) ||
  fail "run this command inside a Git repository"
repo_root=$(cd "$repo_root" && pwd -P)
repo_name=$(basename "$repo_root")
repo_id=$(printf '%s' "$repo_root" | cksum | awk '{print $1}')

case "$target" in
  https://github.com/*)
    pr_path=${target#https://github.com/}
    owner=${pr_path%%/*}
    pr_path=${pr_path#*/}
    repository=${pr_path%%/*}
    pr_path=${pr_path#*/}

    case "$pr_path" in
      pull/*) ;;
      *) fail "invalid GitHub pull request URL: $target" ;;
    esac

    pr_number=${pr_path#pull/}
    pr_number=${pr_number%%[/?#]*}
    case "$pr_number" in
      ''|*[!0-9]*) fail "invalid GitHub pull request URL: $target" ;;
    esac

    origin_url=$(git config --get remote.origin.url 2>/dev/null) ||
      fail "the current repository has no origin remote"
    case "$origin_url" in
      git@github.com:*) origin_slug=${origin_url#git@github.com:} ;;
      ssh://git@github.com/*) origin_slug=${origin_url#ssh://git@github.com/} ;;
      https://github.com/*) origin_slug=${origin_url#https://github.com/} ;;
      http://github.com/*) origin_slug=${origin_url#http://github.com/} ;;
      *) fail "origin is not a GitHub repository: $origin_url" ;;
    esac
    origin_slug=${origin_slug%.git}
    origin_slug=${origin_slug%/}

    [ "$origin_slug" = "$owner/$repository" ] ||
      fail "pull request belongs to $owner/$repository, not $origin_slug"

    command -v gh >/dev/null 2>&1 || fail "gh is required for pull request URLs"
    branch_name=$(gh pr view "$target" --json headRefName --jq .headRefName) ||
      fail "could not resolve pull request branch: $target"
    git check-ref-format --branch "$branch_name" >/dev/null 2>&1 ||
      fail "pull request has an invalid branch name: $branch_name"

    source_ref=refs/pull/$pr_number/head
    fetched_ref=refs/review-worktrees/pr/$pr_number
    ;;
  http://*|https://*)
    fail "expected a GitHub pull request URL: $target"
    ;;
  *)
    branch_name=$target
    git check-ref-format --branch "$branch_name" >/dev/null 2>&1 ||
      fail "invalid branch name: $target"

    source_ref=refs/heads/$branch_name
    fetched_ref=refs/remotes/origin/$branch_name
    ;;
esac

branch_id=$(printf '%s' "$branch_name" | cksum | awk '{print $1}')
branch_label=$(printf '%s' "$branch_name" | tr -c 'A-Za-z0-9._-' '-')
worktree_key=branch-$branch_label-$branch_id
temp_root=${TMPDIR:-/tmp}
worktree_path=${temp_root%/}/review-worktrees/$repo_name-$repo_id/$worktree_key
main_common_dir=$(absolute_common_dir "$repo_root") ||
  fail "could not resolve the repository's common Git directory"

checked_out_path=$(branch_worktree "$branch_name")
if [ -n "$checked_out_path" ] && [ -d "$checked_out_path" ]; then
  exec e "$checked_out_path"
fi

local_branch=false
if git show-ref --verify --quiet "refs/heads/$branch_name"; then
  local_branch=true
fi

if [ -e "$worktree_path" ]; then
  [ -d "$worktree_path" ] ||
    fail "temporary worktree path is not a directory: $worktree_path"

  existing_common_dir=$(absolute_common_dir "$worktree_path") ||
    fail "temporary path exists but is not a Git worktree: $worktree_path"

  [ "$existing_common_dir" = "$main_common_dir" ] ||
    fail "temporary path belongs to another repository: $worktree_path"

  if [ "$local_branch" = true ]; then
    git -C "$worktree_path" switch "$branch_name"
    exec e "$worktree_path"
  fi
fi

if [ "$local_branch" = true ]; then
  git worktree prune
  mkdir -p "$(dirname "$worktree_path")"
  git worktree add "$worktree_path" "$branch_name"
  exec e "$worktree_path"
fi

git worktree prune
git fetch --no-tags origin "+$source_ref:$fetched_ref"
git rev-parse --verify "$fetched_ref^{commit}" >/dev/null ||
  fail "fetched ref does not point to a commit: $fetched_ref"

if [ -e "$worktree_path" ]; then
  git -C "$worktree_path" switch -c "$branch_name" "$fetched_ref"
else
  mkdir -p "$(dirname "$worktree_path")"
  git worktree add -b "$branch_name" "$worktree_path" "$fetched_ref"
fi
exec e "$worktree_path"
